# HEADING OS Workspace - Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env - only .env.example is tracked

# --- GitHub / backup ---
# Token used for all git push / backup auth (push-all.py). Without it,
# backups cannot authenticate. Needs repo scope (and workflow scope if you
# push GitHub Actions workflow files).
GH_TOKEN=

# --- Data overlay path ---
# OPTIONAL explicit override. The engine auto-resolves the sibling
# ../.heading-os-data next to the engine clone by default, so you normally
# leave this unset. Set it to pin the binding when your layout is non-standard
# (data repo not a direct sibling) or as belt-and-suspenders insurance. The
# path is absolute and must be updated if you relocate the workspace.
# Note: this file is only honored by callers that run load_env() first; for
# full coverage of hooks and daemons an exported shell env var
# (export HEADING_OS_DATA=...) is stronger than this line.
# HEADING_OS_DATA=

# --- Read-only data overlay (mirror hosts) ---
# Set this on any host whose data clone is a PULL-ONLY mirror - a daemon VM that
# runs scripts and takes `git pull --ff-only` on a schedule but never commits.
# It stops the CRM auto-log from rewriting contact cards there; without it the
# mirror's working tree goes dirty and every later fast-forward pull aborts.
# Recognised: 1 / true / yes / on. Absent or empty means off. Any other value is
# read as ON, so a typo cannot silently disable the guard.
# HEADING_OS_DATA_READONLY=

# --- Exchange (Corporate Email) ---
EXCHANGE_EMAIL=
EXCHANGE_PASSWORD=
EXCHANGE_SERVER=

# --- Optional Exchange Settings ---
# EXCHANGE_USERNAME=
# EXCHANGE_AUTH_TYPE=
# EXCHANGE_TIMEZONE=

# --- Per-instance local timezone ---
# IANA name used for timestamps, calendar, and daemon scheduling.
# Engine default is UTC; set this to your operating timezone.
# HEADING_OS_TZ=

# --- AI APIs ---
ANTHROPIC_API_KEY=

# --- AI model integrations (all optional) ---
# The model proxy, the council and the consult scripts: docs/CLIPROXY.md.
#
# Local embeddings for /recall + memory-index use bge-m3 on a model server on
# your own network. Two programs are supported: Ollama, which needs no key, and
# Lemonade Server, which needs one (LEMONADE_API_KEY below, named by
# `embed_api_key_env`). With no host config at all the code assumes an Ollama
# at http://localhost:11434.
#
# Which program serves the embeddings, and where, is declared once per machine in
# the gitignored config/inference-hosts.yaml (template:
# config/inference-hosts.example.yaml): `embed` for the address, `embed_provider`
# for the program, `embed_api_key_env` for the variable holding its key. The
# provider is DECLARED, never guessed from the port, and no variable is needed.
# The two variables below override the address for one process, which is what a
# systemd unit or a one-off run wants. Both are read by the code and were
# documented nowhere until 2026-09-06. Leave them unset to use the file.
#
# The old names HEADING_OS_OLLAMA_EMBED_HOST and HEADING_OS_OLLAMA_HOST are
# REFUSED with a line naming the replacement, never silently ignored.
# HEADING_OS_INFERENCE_EMBED_HOST=   # embedding endpoint
# HEADING_OS_INFERENCE_GENERATE_HOST=   # generation endpoint
#
# Lemonade Server runs LOCAL models when config/inference-hosts.yaml names it
# (its *_api_key_env fields name this variable). Unlike Ollama it gates its API behind a
# key, so an unauthenticated request gets 401 rather than a refusal that says
# so.
LEMONADE_API_KEY=
# The port Lemonade binds. The HOST is resolved at call time from this machine's
# default gateway, because on WSL2 the Windows side sits across a NAT boundary
# whose address changes on every restart. Set LEMONADE_HOST to a literal base URL
# only when the server is somewhere that resolution cannot find.
# LEMONADE_PORT=
# LEMONADE_HOST=
#
# /council asks independent models in parallel, and /deep-research-advance uses
# the same transport. ONE credential covers every voice: they all reach their
# model through the local CLIProxyAPI proxy on 127.0.0.1:8317, which holds the
# subscriptions. Set it to one of the keys in the proxy's `api-keys` list
# (docs/CLIPROXY.md). Without it every council voice stops with exit 2.
# These models are third-party clouds; never send private data.
CLIPROXY_API_KEY=

# Perplexity powers /deep-research-advance web acquisition (optional).
PERPLEXITY_API_KEY=
CONTEXT7_API_KEY=

# --- Image Generation ---
REPLICATE_API_TOKEN=

# --- Mattermost Client (/mattermost; a personal access token of your own account) ---
MATTERMOST_URL=
MATTERMOST_TOKEN=

# --- Telegram Client (userbot; /telegram, Sentinel reads) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Optional: which Telegram channel gets the nudges. A numeric id (-100...) or
# an @username - NOT "me"/"self"/"saved" (Saved Messages has no equivalent on
# the notifications bot below and is never a valid target anywhere in this
# system). Unset -> no notification sent (logged).
# ODIN_CADENCE_TELEGRAM_TARGET=
# OPS_RADAR_TELEGRAM_TARGET=
# COUNCIL_MODELS_TELEGRAM_TARGET=   # daily /council model-freshness nudge
#   (falls back to OPS_RADAR_TELEGRAM_TARGET -> ODIN_CADENCE_TELEGRAM_TARGET -> unconfigured)
# SENTINEL_TELEGRAM_TARGET=   # Sentinel urgency alerts + digests
#   (falls back to ODIN_CADENCE_TELEGRAM_TARGET -> unconfigured)
# YARD_WATCH_TELEGRAM_TARGET=   # a yard that has needed attention
#   for longer than the threshold, from the yard-watch Stop hook. NO fallback
#   chain, deliberately: setting this is how you ask for these messages, and
#   unset means the hook still prints in the session and sends nothing.

# --- Telegram Notifications Bot (dedicated Bot API bot; system nudges/alerts) ---
# Separate from the userbot credentials above. Created via @BotFather; must
# be added as admin to whichever channel the *_TELEGRAM_TARGET vars above
# point at. Reliable phone push, unlike a userbot self-send.
# TELEGRAM_NOTIFY_BOT_TOKEN=
# Optional: enables the WEEKLY AUTOMATIC headless `odin reflect --propose` call
# from odin-cadence-notify.py when a reflect-ready cluster exists. Unset/false
# by default -- a manual `heading skill odin reflect --propose` is NEVER gated
# by this flag (typing the command is already the deliberate act).
# ODIN_REFLECT_PROPOSE_ENABLED=

# --- Web Scraping ---
FIRECRAWL_API_KEY=

# --- Decodo residential proxy (LinkedIn scraping; scripts/linkedin-activity.py) ---
# Residential proxy from Decodo (decodo.com) used to route Playwright Chromium
# past LinkedIn anti-bot / rate-limiting. scripts/linkedin-activity.py reads
# them, through scripts/utils/proxy_route.py, as does scripts/browser.py;
# --proxy-slot 0 (default) bypasses the proxy entirely, so all keys are
# OPTIONAL and only needed when you scrape through a slot.
# DECODO_PROXY_1/2/3 are FULL proxy URLs (scheme, credentials, host, port); the
# script reads DECODO_PROXY_{slot} by number. A slot may be http:// or
# socks5h:// (user:pass@host:port either way). Playwright cannot authenticate
# to SOCKS5, so for a socks5h:// slot the script runs an in-process relay on
# 127.0.0.1 for the length of the run: the browser connects to it without
# credentials and the relay logs in to the proxy through PySocks (the `browser`
# extra), with DNS resolved at the proxy. HOST/PASS are the underlying
# account credentials the slot URLs are built from.
# DECODO_PROXY_HOST=
# DECODO_PROXY_PASS=
# DECODO_PROXY_1=
# DECODO_PROXY_2=
# DECODO_PROXY_3=

# --- Web Search (entity resolution, /osint Phase 0.5) ---
# Tavily: signup at https://tavily.com (free tier: 1,000 credits/month)
# Brave Search API: signup at https://brave.com/search/api/ (free tier: 2,000 queries/month)
# Tavily is primary; Brave is the automatic fallback.
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- OSINT / Breach Intelligence ---
DEHASHED_API_KEY=
HIBP_API_KEY=
HUNTER_API_KEY=
VIRUSTOTAL_API_KEY=

# --- Lific issue tracker (optional, only for HTTP / remote mode) ---
# Lific runs local-first: the recommended setup here is a local SQLite instance
# addressed by `lific --config <abs path>/lific.toml`, with the MCP server spoken
# over stdio. That mode needs NO credential and NO variable below.
# These are only for talking to a Lific server over HTTP:
# LIFIC_URL=
# LIFIC_API_KEY=
# LIFIC_TOKEN=
# The Lific bot username the [dossier] journal posts as (scripts/utils/dossier.py); unset posts nothing directly.
# LIFIC_BOT_USER=

# --- Porkbun (DNS API, and delivery of a Porkbun-issued TLS certificate) ---
# Used by scripts/porkbun.py. The CERT_* three are the defaults for `ssl push`
# and the porkbun-cert-push timer: the domain whose certificate Porkbun issues,
# the ssh alias of the server, and the FQDN the certificate must cover.
# PORKBUN_API_KEY=
# PORKBUN_SECRET_API_KEY=
# PORKBUN_CERT_DOMAIN=
# PORKBUN_CERT_HOST=
# PORKBUN_CERT_NAME=

# --- Server backup pull and deployment health (scripts/backup-pull.py, scripts/hindsight-health.py) ---
# BACKUP_HOST and HEALTH_HOST are ssh aliases whose server side is a forced command
# (rrsync -ro for the pull, a read-only status script for health). CIPHER_FILE is a 0600
# file holding the pgBackRest repository passphrase. PGBACKREST is the binary used to
# verify pulled copies; it must read the server's PostgreSQL major version.
# HINDSIGHT_BACKUP_HOST=
# HINDSIGHT_BACKUP_DIR=
# HINDSIGHT_BACKUP_CIPHER_FILE=
# HINDSIGHT_BACKUP_KEEP=
# HINDSIGHT_BACKUP_STANZA=
# HINDSIGHT_PGBACKREST=
# HINDSIGHT_HEALTH_HOST=
# HINDSIGHT_HEALTH_UI_NAME=
# HINDSIGHT_HEALTH_API_URL=
# HINDSIGHT_HEALTH_BACKUP_MAX_H=

# --- Blind model comparison on the memory server (scripts/hindsight-model-bench.py) ---
# HOST is a full-shell ssh alias of the memory server (not the forced-command aliases above);
# PYTHON is the server's interpreter that has hindsight_api; KEY_FILE is the proxy key file ON
# the server, read there and never copied here.
# HINDSIGHT_BENCH_HOST=
# HINDSIGHT_BENCH_PYTHON=
# HINDSIGHT_BENCH_KEY_FILE=

# --- Off-machine copy of the Hindsight snapshot (scripts/hindsight-snapshot-offsite.py) ---
# PASSPHRASE_FILE is a 0600 file holding the gpg passphrase; keep the same passphrase in the
# password manager, never in Drive and never in git. FOLDER is the Drive folder name.
# HINDSIGHT_OFFSITE_PASSPHRASE_FILE=
# HINDSIGHT_OFFSITE_FOLDER=

# --- Zoom presence (scripts/zoom-presence.py; is the user in a meeting now) ---
# A Server-to-Server OAuth app in the Zoom Marketplace with the one scope
# user:read:presence_status:admin. USER_EMAIL is the Zoom login of the user to
# read: an S2S app cannot address the user as "me".
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_USER_EMAIL=
