[Unit]
Description=Exchange + Calendar sync daemon
After=network.target

[Service]
Type=simple
WorkingDirectory={{WORKSPACE}}
ExecStart={{PYTHON}} scripts/sync-exchange-daemon.py daemon
Restart=on-failure
RestartSec=10
# journald avoids double-writing the daemon's log path on a /mnt/c 9P mount,
# which can freeze the process in uninterruptible sleep.
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
# TZ pins the daemon's local dates to the configured timezone regardless of the
# host. The installer substitutes {{TZ}} from HEADING_OS_TZ (default UTC).
Environment=TZ={{TZ}}

[Install]
WantedBy=default.target
