[Unit]
Description=Daily morning-dashboard HTML to the operator's own Telegram sink
After=network.target

[Service]
Type=oneshot
WorkingDirectory={{WORKSPACE}}
ExecStart={{PYTHON}} {{WORKSPACE}}/scripts/dashboard-telegram-notify.py
# TZ pins the dashboard's date (the dated output directory, the caption) to the
# configured timezone regardless of the host. The installer substitutes {{TZ}}
# from HEADING_OS_TZ (default UTC). journald avoids a log path on a /mnt/c 9P mount.
# NOTE: deliberately NO SuccessExitStatus. Exit 1 means the dashboard was not
# delivered, and that is meant to show as `failed`.
Environment=TZ={{TZ}}
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
