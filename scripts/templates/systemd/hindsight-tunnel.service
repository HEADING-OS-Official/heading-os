[Unit]
Description=Persistent SSH tunnel (ssh alias {{ALIAS}}; forwards come from ~/.ssh/config)
StartLimitIntervalSec=0

[Service]
# The alias carries BatchMode, StrictHostKeyChecking, ExitOnForwardFailure and the
# ServerAlive settings, so a dead link is noticed in about 45 s and restarted here.
ExecStart=/usr/bin/ssh -F %h/.ssh/config -N {{ALIAS}}
Restart=always
# 30 s, not 5: the server's ufw allows 6 ssh connections per 30 s from one address, and a
# tunnel failing every 5 s used up that budget alone (2026-09-30: 22 restarts after a laptop
# reboot, UFW LIMIT BLOCK on port 22 at 11:42 UTC, admin ssh hung behind it).
RestartSec=30

[Install]
WantedBy=default.target
