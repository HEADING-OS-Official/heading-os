[Unit]
Description=Daily morning-dashboard to Telegram (08:00, configured timezone)

[Timer]
# Daily 08:00 in the configured timezone. The installer substitutes {{TZ}} from
# HEADING_OS_TZ (default UTC); the trailing timezone pins the fire even when the
# host's local timezone differs (systemd >= 252). Persistent=true catches a fire
# missed because the host was off, running it on next boot. Every fire builds
# today's dashboard and sends it, so a delivery is expected every day.
OnCalendar=*-*-* 08:00:00 {{TZ}}
Persistent=true

[Install]
WantedBy=timers.target
